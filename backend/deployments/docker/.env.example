# Copy to .env and adjust for production
APP_ENV=production
JWT_SECRET=replace-with-long-random-secret
WEBHOOK_SECRET=replace-with-webhook-hmac-secret
MESSAGING_DRIVER=amqp
AMQP_URL=amqp://sparkops:sparkops@rabbitmq:5672/
RUNTIME_DRIVER=k8s
DELIVERY_DRIVER=jenkins
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=ci
JENKINS_TOKEN=
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
KUBECONFIG=/secrets/kubeconfig
OPENAI_API_KEY=
MINIO_ROOT_USER=sparkops
MINIO_ROOT_PASSWORD=replace-with-minio-password
FILESYSTEM_MAX_FILE_BYTES=21474836480
FILESYSTEM_RECONCILER_INTERVAL=30s
FILESYSTEM_RECONCILER_LEASE_TTL=90s
FILESYSTEM_RECONCILER_BATCH_SIZE=100
FILESYSTEM_RECONCILER_GC_GRACE_PERIOD=168h
# Production must inject a persistent PEM through a secret.
SPARKOPS_SFTP_HOST_KEY_PEM=

# Entitlement 缓存 TTL（秒）。0 = 关闭缓存；默认 30
ENTITLEMENTS_CACHE_TTL_SECONDS=30

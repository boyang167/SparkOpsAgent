{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "filesystem",
    "fileTransferGateway",
    "fileWorker",
    "sftpGateway",
    "fileReconciler"
  ],
  "properties": {
    "filesystem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "maxFileBytes", "providerSecretRefs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxFileBytes": {"type": "integer", "minimum": 1},
        "existingSecret": {"type": "string"},
        "providerSecretRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fileTransferGateway": {
      "$ref": "#/definitions/scalableWorkload"
    },
    "fileWorker": {
      "$ref": "#/definitions/scalableWorkload"
    },
    "sftpGateway": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "type": "object",
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        }
      ]
    },
    "fileReconciler": {
      "$ref": "#/definitions/workload"
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["replicaCount", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    },
    "scalableWorkload": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "type": "object",
          "required": ["autoscaling"],
          "properties": {
            "autoscaling": {
              "type": "object",
              "required": ["enabled", "minReplicas", "maxReplicas"],
              "properties": {
                "enabled": {"type": "boolean"},
                "minReplicas": {"type": "integer", "minimum": 1},
                "maxReplicas": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      ]
    }
  }
}
